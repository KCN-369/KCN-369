+    out.append(f'<circle cx="{rcx}" cy="{rcy}" r="{R + 22}" fill="url(#halo)"/>')
+    out.append(f'<circle cx="{rcx}" cy="{rcy}" r="{R + 14}" fill="none" stroke="{CY}" stroke-opacity=".35" stroke-width="1" stroke-dasharray="2 6" class="spin"/>')
+    out.append(f'<circle cx="{rcx}" cy="{rcy}" r="{R + 20}" fill="none" stroke="{MG}" stroke-opacity=".35" stroke-width="2" stroke-dasharray="40 {2 * math.pi * (R + 20) - 40:.0f}" class="spinr"/>')
+    out.append(f'<circle cx="{rcx}" cy="{rcy}" r="{R}" fill="none" stroke="#1B2238" stroke-width="10"/>')
+    out.append(f'<circle cx="{rcx}" cy="{rcy}" r="{R}" fill="none" stroke="url(#ring)" stroke-width="10" stroke-linecap="round" '
+               f'stroke-dasharray="{circ:.1f}" stroke-dashoffset="{circ * (1 - prog):.1f}" transform="rotate(-90 {rcx} {rcy})" class="fill" filter="url(#glow)"/>')
