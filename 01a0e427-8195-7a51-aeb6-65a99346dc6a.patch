diff --git a/.github/workflows/profile-assets.yml b/.github/workflows/profile-assets.yml
new file mode 100644
index 0000000..5d5b89c
--- /dev/null
+++ b/.github/workflows/profile-assets.yml
@@ -0,0 +1,47 @@
+name: profile-assets
+
+# Regenerates the live cards shown in README.md from real GitHub data:
+#   profile/telemetry.svg  -> stat tiles + LEVEL SYSTEM (XP ring, rank, stats, languages)
+#   profile/contrib3d.svg  -> isometric 3D contribution graph (last 12 months)
+# Generator: scripts/profile_cards.py (Python standard library only).
+#
+# Optional: add a classic Personal Access Token as the repo secret PROFILE_TOKEN
+# (scope: read:user) to include private contributions in the numbers.
+
+on:
+  schedule:
+    - cron: "0 */6 * * *" # every 6 hours
+  workflow_dispatch:
+  push:
+    branches: [main]
+    paths:
+      - ".github/workflows/profile-assets.yml"
+      - "scripts/profile_cards.py"
+      - "README.md"
+
+permissions:
+  contents: write
+
+concurrency:
+  group: profile-assets
+  cancel-in-progress: true
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v6
+
+      - name: Generate cards
+        env:
+          GITHUB_TOKEN: ${{ secrets.PROFILE_TOKEN || secrets.GITHUB_TOKEN }}
+        run: python3 scripts/profile_cards.py --user "${{ github.repository_owner }}" --out profile
+
+      - name: Commit updated cards
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add profile/*.svg
+          git diff --cached --quiet && echo "No changes" && exit 0
+          git commit -m "chore(profile): refresh live cards [skip ci]"
+          git push
