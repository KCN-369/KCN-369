+    # ---- row 1: stat tiles ----
+    tiles = [
+        ("repo", kfmt(d["repos"]), "REPOSITORIES", CY),
+        ("commit", kfmt(d["commits_year"]), f"COMMITS ({d['year']})", GR),
+        ("star", kfmt(d["stars"]), "STARS EARNED", AM),
