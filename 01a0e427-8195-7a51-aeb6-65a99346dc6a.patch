+        out.append(f'<rect x="{x + .75:.1f}" y=".75" width="{tw - 1.5:.1f}" height="{th - 1.5}" rx="14" fill="{PB}" stroke="{c}" stroke-opacity=".35" stroke-width="1.5"/>')
+        out.append(f'<rect x="{x + .75:.1f}" y=".75" width="{tw - 1.5:.1f}" height="{th - 1.5}" rx="14" fill="none" stroke="{c}" stroke-width="2" '
+                   f'stroke-dasharray="70 {2 * (tw + th) - 70:.0f}" class="trace" style="animation-delay:-{i * 1.3:.1f}s"/>')
