+    out.append(f'<text x="26" y="{Y + 38}" font-size="16" font-weight="700" fill="{TXT}" letter-spacing="1.5"><tspan fill="{VI}">✦</tspan> GITHUB STATS</text>')
+    # heartbeat
+    hb = "M0,10 L22,10 L28,3 L34,17 L40,10 L58,10 L63,0 L69,20 L75,10 L96,10 L101,5 L107,15 L112,10 L140,10"
+    out.append(f'<g transform="translate(250 {Y + 20})"><path d="{hb}" fill="none" stroke="{VI}" stroke-opacity=".25" stroke-width="1.5"/>'
